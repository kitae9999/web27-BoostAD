CORS_ORIGIN=*

CLIENT_URL=https://localhost:5173

NODE_ENV=development

DB_HOST=localhost
DB_PORT=13306
DB_USERNAME=test_user
DB_PASSWORD=test_user
DB_DATABASE=test_db

REDIS_HOST=localhost
REDIS_PORT=16379
# legacy: 위 단일 endpoint를 세 역할이 공유, split: 아래 URL 사용
REDIS_TOPOLOGY_MODE=legacy
SEARCH_REDIS_URL=redis://localhost:16379
BUDGET_REDIS_URL=redis://localhost:16380
QUEUE_REDIS_URL=redis://localhost:16381
# CRUD는 모든 모드에서 MySQL과 Outbox를 함께 commit한다.
# off: worker 중지, shadow: split projection만 구축, active: split serving/정산
CAMPAIGN_PROJECTION_MODE=off
SEARCH_PROJECTION_STREAM_MAXLEN=100000
PROJECTION_WORKER_CONCURRENCY=8
PROJECTION_WORKER_POLL_MS=100
PROJECTION_WORKER_LEASE_MS=30000
PROJECTION_WORKER_MAX_ATTEMPTS=20
REDIS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
REDIS_CIRCUIT_BREAKER_OPEN_MS=5000
RTB_CAMPAIGN_SOURCE=redis_json
RTB_EMBEDDING_PROFILE=multilingual_e5_small
RTB_EMBEDDING_QUEUE_NAME=
RTB_DENSE_RETRIEVAL_MODE=semantic_document
RTB_MATCHER_DOCUMENT_SIMILARITY_THRESHOLD=0.3
RTB_BUDGET_MODE=winner_only
RTB_AUCTION_RESERVATION_TTL_MS=900000
RTB_AUCTION_TERMINAL_TTL_SECONDS=1800
RTB_RESERVATION_SWEEP_INTERVAL_MS=1000
RTB_RESERVATION_SWEEP_BATCH_SIZE=100
RTB_RESERVATION_SWEEP_TIME_BUDGET_MS=200
RTB_RESERVATION_SWEEP_MAX_BATCHES=10
# dense_only | hybrid
RTB_RETRIEVAL_MODE=dense_only
# RTB_HYBRID_RRF_K=60
# RTB_HYBRID_DENSE_WEIGHT=1
# RTB_HYBRID_SPARSE_WEIGHT=0.2
# RTB_HYBRID_SPARSE_SUPPLEMENT_LIMIT=10
# RTB_HYBRID_FINAL_LIMIT=10

GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=your_redirect_uri

JWT_SECRET=your_jwt_secret

NCP_ACCESS_KEY=YOUR_ACCESS_KEY_HERE
NCP_SECRET_KEY=YOUR_SECRET_KEY_HERE
NCP_REGION=kr-standard
NCP_ENDPOINT=https://kr.object.ncloudstorage.com
NCP_BUCKET=boostadad-campaign-images

TOSS_SECRET_KEY=test_sk_여기에_발급받은_시크릿키
